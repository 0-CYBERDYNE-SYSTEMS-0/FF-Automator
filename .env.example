# =============================================================================
# LLM Provider API Keys
# =============================================================================
# Get your API keys from the respective provider websites:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/account/keys
# - Google: https://console.cloud.google.com/apis/credentials
# - DeepSeek: https://platform.deepseek.com/api_keys
# - OpenRouter: https://openrouter.ai/keys

# OpenAI (GPT-4.1, o3, o4-mini, o3-pro models)
OPENAI_API_KEY=

# Anthropic (Claude 4, Claude 3.5, Claude 3 models)
ANTHROPIC_API_KEY=

# Google (Gemini 2.5, Gemini 2.0, Gemini 1.5 models)
GEMINI_API_KEY=

# DeepSeek (deepseek-chat, deepseek-reasoner models)
DEEPSEEK_API_KEY=

# OpenRouter (Access to 400+ models, includes free options)
OPENROUTER_API_KEY=

# =============================================================================
# Local LLM Provider Configuration (Optional)
# =============================================================================
# These are automatically detected if running locally

# Ollama (Local models - automatically detected on localhost:11434)
# No API key needed - will auto-detect if Ollama is running
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ENABLED=true

# LM Studio (Local models - automatically detected on localhost:1234)
# No API key needed - will auto-detect if LM Studio is running
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_ENABLED=true

# =============================================================================
# Provider Preferences (Optional)
# =============================================================================
# Set your preferred provider and model for automatic selection
DEFAULT_LLM_PROVIDER=OpenAI
DEFAULT_LLM_MODEL=gpt-4.1

# Fallback providers (comma-separated, in order of preference)
FALLBACK_PROVIDERS=DeepSeek,OpenRouter,Ollama

# =============================================================================
# Advanced Provider Settings (Optional)
# =============================================================================
# OpenRouter specific settings
OPENROUTER_SITE_URL=https://macOS-use-app.local
OPENROUTER_APP_NAME=macOS-use Agent

# Model selection preferences by task type
REASONING_PREFERRED_PROVIDER=OpenAI
REASONING_PREFERRED_MODEL=o3
CODING_PREFERRED_PROVIDER=Anthropic
CODING_PREFERRED_MODEL=claude-4-sonnet
CHAT_PREFERRED_PROVIDER=Google
CHAT_PREFERRED_MODEL=gemini-2.5-flash

# Cost optimization settings
ENABLE_COST_OPTIMIZATION=true
MAX_COST_PER_REQUEST=0.10
PREFER_FREE_MODELS=false

# =============================================================================
# Application Settings
# =============================================================================
# Set to false to disable anonymized telemetry
ANONYMIZED_TELEMETRY=false

# LogLevel: Set to debug to enable verbose logging, set to result to get results only. Available: result | debug | info
BROWSER_USE_LOGGING_LEVEL=info

# Provider health check interval (minutes)
PROVIDER_HEALTH_CHECK_INTERVAL=30

# Enable/disable automatic provider switching on failure
AUTO_PROVIDER_FAILOVER=true
